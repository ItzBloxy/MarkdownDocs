{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MarkdownDocs",
  "version": "0.1.0",
  "identifier": "com.markdowndocs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "MarkdownDocs",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ItzBloxy",
    "copyright": "Copyright © 2026 ItzBloxy",
    "category": "Productivity",
    "shortDescription": "A desktop editor for Markdown files",
    "longDescription": "MarkdownDocs edits Markdown files like documents and saves them back as clean Markdown.",
    "homepage": "https://github.com/ItzBloxy/MarkdownDocs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "txt"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
